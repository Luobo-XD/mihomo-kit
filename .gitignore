# mihomo 运行时产物与凭据 —— 不要提交

# 含订阅链接（账号 token）
config/config.yaml
# proxy sub 的机场清单与备份（含 token）
config/airports.conf
config/airports.conf.bak
config/config.yaml.bak-*

# 订阅节点缓存（含节点地址/端口/密码）
config/providers/

# mihomo 运行时缓存
config/cache.db
config/cache.db.*

# 语言/时区对齐的运行时状态
config/region.json

# 网络白名单（本机网络信息，仅本地；模板 networks.conf.example 入库）
config/networks.conf
config/networks.conf.bak

# LAN 共享认证凭证（本机随机生成，仅本地；模板 lan-auth.conf.example 入库）
config/lan-auth.conf

# 本机/用户输入覆盖（模板 local.conf.example 入库）
config/local.conf

# 本机待办/未验证项（本地留存，不入库）
docs/todo.local.md

# 本机实际环境数据（模板 docs/local-env.md 入库）
docs/local-env.local.md

# 日志
config/*.log
*.log

# Python 字节码缓存
__pycache__/
*.pyc

# 编辑器
*.swp
*~

# 规则集下载缓存（二进制，可从 URL 重新获取）
config/rules/

# AUR 构建目录（222MB，且自带独立 git 仓库；仅本地留档，不入本仓库）
mihomo-aur-build/

# KDE 文件夹元数据
.directory
