#!/usr/bin/env bash
# ============================================================
# proxy —— 手动开关 / 查询 mihomo 代理
#   通过 mihomo 控制器 (127.0.0.1:9090) 运行时切换 TUN，无需 sudo
# ============================================================
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=libproxy.sh
. "$SELF_DIR/libproxy.sh"

tun_device_present() {
  ip link show mihomo >/dev/null 2>&1 && echo "存在" || echo "无"
}

cmd_status() {
  local st tun net msg nodeline region lanim
  st="$(tun_state)"
  tun="$(tun_device_present)"
  net="$(network_name)"
  nodeline="$(node_status_line)"
  region="$(region_status_lines)"
  case "$st" in
    true)  msg="已开启" ;;
    false) msg="已关闭" ;;
    *)     msg="未知（控制器不可达）" ;;
  esac
  case "$(lan_state)" in
    true)  lanim="已开启" ;;
    false) lanim="已关闭" ;;
    *)     lanim="未知" ;;
  esac
  printf '梯子：%s\nTUN 网卡：%s\n当前网络：%s\n局域网共享：%s\n%s\n%s\n' \
    "$msg" "$tun" "${net:-无}" "$lanim" "$nodeline" "$region"
  _notify "梯子：$msg" "网络：${net:-无}  ${nodeline}"
}

cmd_on() {
  set_tun true
  printf '梯子：已开启\n'
  _notify "梯子：已开启" "已手动开启全局 TUN"
  time_check_auto
  region_sync_auto
}

cmd_off() {
  set_tun false
  printf '梯子：已关闭\n'
  _notify "梯子：已关闭" "已手动关闭全局 TUN"
  region_sync_off
}

cmd_toggle() {
  if [ "$(tun_state)" = "true" ]; then cmd_off; else cmd_on; fi
}

cmd_usage() {
  local n printed=0 out
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    out="$(usage_info_for "$n")"
    [ -z "$out" ] && continue
    printed=$((printed + 1))
    printf '【%s】\n%s\n\n' "$n" "$out"
  done < <(all_providers)
  if [ "$printed" -eq 0 ]; then
    printf '无法读取订阅信息（控制器不可达或机场未返回）\n'
    _notify "订阅信息" "读取失败"
    return 1
  fi
  _notify "订阅用量" "共 $printed 个机场，详见终端"
}

# ---------- proxy sub：机场订阅管理 ----------
cmd_sub_list() {
  local name url info cnt upd
  printf '%-14s %-6s %-20s %s\n' "名字" "节点" "更新时间" "链接"
  while IFS=$'\t' read -r name url; do
    [ -z "$name" ] && continue
    info="$(api_get "/providers/proxies/$name")"
    cnt="$(printf '%s' "$info" | python3 -c 'import sys,json;print(len(json.load(sys.stdin).get("proxies") or []))' 2>/dev/null || echo '?')"
    upd="$(printf '%s' "$info" | python3 -c 'import sys,json;print((json.load(sys.stdin).get("updatedAt") or "?")[:19])' 2>/dev/null || echo '?')"
    printf '%-14s %-6s %-20s %s\n' "$name" "$cnt" "$upd" "$(mask_url "$url")"
  done < <(subs_list)
}

cmd_sub_show() {
  local name="${1:-}" url
  subs_has "$name" || { echo "清单里没有：$name"; return 1; }
  url="$(subs_get "$name")"
  printf '机场：%s\n链接：%s\n' "$name" "$(mask_url "$url")"
  api_get "/providers/proxies/$name" | python3 -c '
import sys, json, datetime
d = json.load(sys.stdin)
print("节点数:", len(d.get("proxies") or []))
print("更新时间:", (d.get("updatedAt") or "?")[:19])
si = d.get("subscriptionInfo") or {}
up = si.get("Upload",0) or 0; dn = si.get("Download",0) or 0
t = si.get("Total",0) or 0; e = si.get("Expire",0) or 0
def h(x):
    try: x = float(x)
    except Exception: return "?"
    for u in ("B","KiB","MiB","GiB","TiB"):
        if x < 1024: return "%.2f%s" % (x, u)
        x /= 1024
    return "%.2fPiB" % x
print("已用: %s / 总量: %s" % (h(up+dn), h(t) if t else "未返回"))
print("到期:", datetime.datetime.fromtimestamp(e).strftime("%Y-%m-%d") if e else "未返回")
' 2>/dev/null || echo '（无法读取 provider 状态：控制器不可达或未加载）'
}

cmd_sub_add() {
  local name="${1:-}" url
  url="$(clean_url "${2:-}")"
  [ -n "$name" ] && [ -n "$url" ] || { echo "用法: proxy sub add <名字> <链接>"; return 2; }
  case "$name" in *[!A-Za-z0-9_-]*) echo "名字只能用字母/数字/_/-"; return 2 ;; esac
  case "$url" in http://*|https://*) ;; *) echo "链接必须以 http:// 或 https:// 开头"; return 2 ;; esac
  subs_has "$name" && { echo "已存在机场：$name（改用 proxy sub set $name <链接>）"; return 1; }
  cp -a "$SUBS_FILE" "$SUBS_BAK" 2>/dev/null || true
  printf '%s\t%s\n' "$name" "$url" >> "$SUBS_FILE"
  if ! subs_apply; then cp -a "$SUBS_BAK" "$SUBS_FILE"; return 1; fi
  reload_and_reapply
  subs_fetch_one "$name" || true
  _notify "机场已添加" "$name"
  echo "已添加机场：$name"
  cmd_sub_show "$name"
}

cmd_sub_set() {
  local name="${1:-}" url
  url="$(clean_url "${2:-}")"
  [ -n "$name" ] && [ -n "$url" ] || { echo "用法: proxy sub set <名字> <链接>"; return 2; }
  subs_has "$name" || { echo "清单里没有：$name（改用 proxy sub add）"; return 1; }
  case "$url" in http://*|https://*) ;; *) echo "链接必须以 http:// 或 https:// 开头"; return 2 ;; esac
  cp -a "$SUBS_FILE" "$SUBS_BAK"
  python3 - "$SUBS_FILE" "$name" "$url" <<'PY'
import sys
f, name, url = sys.argv[1], sys.argv[2], sys.argv[3]
out = []; done = False
for line in open(f, encoding="utf-8"):
    s = line.rstrip("\n")
    if (not s.strip().startswith("#")) and s.split("\t", 1)[0].strip() == name and not done:
        out.append("%s\t%s" % (name, url)); done = True
    else:
        out.append(s)
open(f, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY
  if ! subs_apply; then cp -a "$SUBS_BAK" "$SUBS_FILE"; reload_and_reapply; return 1; fi
  reload_and_reapply
  subs_fetch_one "$name" || true
  _notify "机场链接已更新" "$name"
  echo "已更新机场链接：$name"
  cmd_sub_show "$name"
}

cmd_sub_rm() {
  local name="${1:-}"
  subs_has "$name" || { echo "清单里没有：$name"; return 1; }
  [ "$(subs_count)" -le 1 ] && { echo "至少保留一个机场，拒绝删除最后一个"; return 1; }
  cp -a "$SUBS_FILE" "$SUBS_BAK"
  python3 - "$SUBS_FILE" "$name" <<'PY'
import sys
f, name = sys.argv[1], sys.argv[2]
out = []
for line in open(f, encoding="utf-8"):
    s = line.rstrip("\n")
    if (not s.strip().startswith("#")) and s.split("\t", 1)[0].strip() == name:
        continue
    out.append(s)
open(f, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY
  if ! subs_apply; then cp -a "$SUBS_BAK" "$SUBS_FILE"; return 1; fi
  rm -f "$PROVIDERS_DIR/$name.yaml"          # 顺手删掉该机场缓存
  reload_and_reapply
  _notify "机场已移除" "$name"
  echo "已移除机场：$name"
  cmd_sub_list
}

cmd_sub_fetch() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    subs_has "$name" || { echo "清单里没有：$name"; return 1; }
    subs_fetch_one "$name"
  else
    local n
    while IFS= read -r n; do
      [ -n "$n" ] && subs_fetch_one "$n"
    done < <(subs_names)
  fi
  node_gone_check          # 刷新后固定节点可能已消失 → 弹提示
}

cmd_sub_help() {
  cat <<EOF
${C_TITLE}proxy sub —— 机场订阅管理${C_OFF}

  ${C_BOLD}proxy sub list${C_OFF}                 列出所有机场（名字/节点数/更新时间/链接掩码）
  ${C_BOLD}proxy sub show <名字>${C_OFF}          查看某机场详情（节点数/用量/到期）
  ${C_BOLD}proxy sub add <名字> <链接>${C_OFF}    新增机场（自动清洗链接、渲染配置、拉取）
  ${C_BOLD}proxy sub set <名字> <链接>${C_OFF}    修改某机场链接
  ${C_BOLD}proxy sub rm <名字>${C_OFF}            移除机场
  ${C_BOLD}proxy sub fetch [名字]${C_OFF}         强制刷新（先走 API，失败自动直连兜底）

${C_TITLE}说明${C_OFF}
  ${C_DIM}* 机场清单存于 config/airports.conf（含 token，权限 600，已 gitignore）。${C_OFF}
  ${C_DIM}* 本命令会把清单渲染进 config.yaml 的标记块并同步策略组，自动 mihomo -t 校验，失败回滚。${C_OFF}
  ${C_DIM}* 每个机场自动加 [名字] 前缀，避免多机场节点重名。${C_OFF}
EOF
}

cmd_sub() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)  cmd_sub_list ;;
    add)   cmd_sub_add "$@" ;;
    set)   cmd_sub_set "$@" ;;
    rm)    cmd_sub_rm "$@" ;;
    fetch) cmd_sub_fetch "$@" ;;
    show)  cmd_sub_show "$@" ;;
    ""|-h|--help|help) cmd_sub_help ;;
    *) printf '未知子命令：%s\n\n' "$sub"; cmd_sub_help; return 2 ;;
  esac
}

cmd_reload() {
  local want net
  reload_config
  provider_refresh
  provider_healthcheck
  # PUT /configs 会按配置把 TUN 与 allow-lan 复位，这里按当前网络重新施加
  want="$(desired_state)"
  net="$(network_name)"
  if [ "$want" = "on" ]; then set_tun true; else set_tun false; fi
  apply_lan_for_network
  printf '配置已重载，并按当前网络（%s）重新施加 TUN=%s、局域网共享=%s\n' "${net:-无}" "$want" "$(lan_state)"
  _notify "梯子：已重载" "当前网络 ${net:-无} → TUN=$want，LAN=$(lan_state)"
  time_check_auto
  region_sync_auto
  node_gone_check
}

cmd_time() {
  # 时间同步：比对本地与节点时间；--set 才写系统时钟（见 bin/proxytime.py）
  exec python3 "$SELF_DIR/proxytime.py" "$@"
}

cmd_lang() {
  # 语言/时区对齐：浏览器对外语言/时区跟随节点（见 bin/proxylang.py）
  exec python3 "$SELF_DIR/proxylang.py" "$@"
}

# ---------- proxy node：手动选择/固定节点 ----------
cmd_node_list() {
  local ping=0 now nodes delay_json count
  [ "${1:-}" = "--ping" ] && ping=1
  now="$(group_now)"
  nodes="$(group_nodes)"
  if [ -z "$nodes" ]; then
    echo "无法读取节点列表（控制器不可达）"
    return 1
  fi
  if [ "$ping" -eq 1 ]; then
    count="$(printf '%s\n' "$nodes" | grep -c . || true)"
    printf '测速中（%s 个节点，可能数秒）…\n' "$count" >&2
    delay_json="$(group_delay_map)"
  else
    delay_json='{}'
  fi
  NODES="$nodes" NOW="$now" DELAYS="$delay_json" python3 -c '
import os, json, sys
now = os.environ.get("NOW", "")
nodes = [n for n in os.environ.get("NODES", "").splitlines() if n]
try:
    delays = json.loads(os.environ.get("DELAYS", "{}") or "{}")
except Exception:
    delays = {}
if not nodes:
    print("无法读取节点列表（控制器不可达）"); sys.exit(1)
print("序号  当前  节点                                  延迟")
for i, n in enumerate(nodes, 1):
    mark = ">" if n == now else " "
    v = delays.get(n)
    d = ("超时/失败" if v >= 5000 else "%dms" % v) if isinstance(v, int) and v > 0 else "-"
    print("%3d   [%s]  %-34s  %s" % (i, mark, n, d))
'
}

cmd_node_use() {
  local arg="${1:-}" name
  [ -n "$arg" ] || { echo "用法: proxy node use <序号|名字|子串>"; return 2; }
  name="$(resolve_node "$arg")" || return 2
  [ "$name" = "自动选择" ] && { cmd_node_auto; return; }
  [ "$name" = "DIRECT" ] && echo "注意：DIRECT 为直连（不是节点），选定后不走代理。" >&2
  if select_node "$name"; then
    printf '已固定节点：%s\n' "$name"
    _notify "节点已固定" "$name（重启 mihomo 仍生效）"
    printf '%s' "$name" > "$NODE_PIN_STATE" 2>/dev/null || true
    region_sync_auto
  else
    echo "切换失败（控制器不可达或该节点不可选）：$name" >&2
    return 1
  fi
}

cmd_node_auto() {
  if select_node "自动选择"; then
    printf '已切回「自动选择」（不固定，随测速漂移）\n'
    _notify "节点：自动选择" "已取消固定"
    rm -f "$NODE_PIN_STATE" 2>/dev/null || true
    region_sync_auto
  else
    echo "切换失败（控制器不可达）" >&2
    return 1
  fi
}

cmd_node_ping() {
  local arg="${1:-}" name delay_json
  delay_json="$(group_delay_map)"
  [ -n "$delay_json" ] || { echo "测速失败（控制器不可达或超时）" >&2; return 1; }
  if [ -n "$arg" ]; then
    name="$(resolve_node "$arg")" || return 2
    printf '%s' "$delay_json" | python3 -c '
import sys, json
name = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
v = d.get(name)
if v is None:
    print("%s：无数据（不可用/超时）" % name)
elif isinstance(v, int) and v >= 5000:
    print("%s：超时/失败" % name)
else:
    print("%s：%dms" % (name, v))
' "$name"
  else
    printf '%s' "$delay_json" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
if not d:
    print("无测速结果"); raise SystemExit
for n, v in sorted(d.items(), key=lambda kv: kv[1]):
    print("%-34s %s" % (n, "超时/失败" if (isinstance(v, int) and v >= 5000) else "%dms" % v))
'
  fi
}

cmd_node_help() {
  cat <<EOF
${C_TITLE}proxy node —— 手动选择 / 固定节点（作用于 PROXY 组）${C_OFF}

  ${C_BOLD}proxy node${C_OFF}                     = list（默认）
  ${C_BOLD}proxy node list [--ping]${C_OFF}       列出可选节点（序号/当前/延迟）；--ping 才测速
  ${C_BOLD}proxy node use <序号|名字|子串>${C_OFF} 选定并固定（自动解析；重启 mihomo 仍生效）
  ${C_BOLD}proxy node <序号|名字>${C_OFF}         等价于 use（便捷写法）
  ${C_BOLD}proxy node auto${C_OFF}                切回「自动选择」（不固定，随测速漂移）
  ${C_BOLD}proxy node ping [序号|名字]${C_OFF}     测速；不带参数=测全组
  ${C_BOLD}proxy node current${C_OFF}             显示当前节点 + 固定/自动

${C_TITLE}说明${C_OFF}
  ${C_DIM}* 选择写入 mihomo（profile.store-selected: true）→ 重启后仍生效（即“固定”）。${C_OFF}
  ${C_DIM}* 固定节点在机场刷新后消失时，mihomo 静默回退「自动选择」，并弹一次「固定节点已失效」通知。${C_OFF}
  ${C_DIM}* proxy status 的「节点」行会标注（固定）/（自动）/（直连）。${C_OFF}
EOF
}

cmd_node() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|list)     cmd_node_list "$@" ;;
    use)         cmd_node_use "$@" ;;
    auto)        cmd_node_auto ;;
    ping)        cmd_node_ping "$@" ;;
    current)     cmd_node_current ;;
    -h|--help|help) cmd_node_help ;;
    *)           cmd_node_use "$sub" "$@" ;;   # proxy node <序号|名字>
  esac
}

cmd_node_current() {
  node_status_line
}

# ---------- proxy net：网络白名单（TUN 在哪些网络下自动开启，见 README「网络白名单」）----------
# 白名单逻辑在 bin/proxynet.sh，数据在 config/networks.conf

# 修改白名单后，按当前网络立即重新施加 TUN（否则要等下次网络变化才生效）
net_reapply() {
  local want net
  want="$(desired_state)"
  net="$(network_name)"
  # 局域网共享与 TUN 联动：仅“离开白名单自动关”，不自动开（handled in libproxy）
  apply_lan_for_network || true
  if [ "$want" = "on" ]; then
    if set_tun true; then
      printf '按当前网络（%s）重新施加 TUN=on、局域网共享=%s\n' "${net:-无}" "$(lan_state)"
      _notify "梯子：已开启" "网络：${net:-无}（白名单）"
      time_check_auto
      region_sync_auto
    else
      echo "施加 TUN 失败（控制器不可达）" >&2
      return 1
    fi
  else
    if set_tun false; then
      printf '按当前网络（%s）重新施加 TUN=off、局域网共享=%s\n' "${net:-无}" "$(lan_state)"
      _notify "梯子：已关闭" "网络：${net:-无}"
      region_sync_off
    else
      echo "施加 TUN 失败（控制器不可达）" >&2
      return 1
    fi
  fi
}

cmd_net_list() {
  local uuid name note mark u n i
  local uuids=() names=()
  while IFS='|' read -r u n; do
    [ -n "$u" ] && { uuids+=("$u"); names+=("$n"); }
  done < <(current_network)
  printf '%-40s %-16s %-4s %s\n' "UUID" "连接名" "命中" "备注"
  while IFS=$'\t' read -r uuid name note; do
    mark=""
    for i in "${!uuids[@]}"; do
      if { [ -n "$uuid" ] && [ "${uuids[$i]}" = "$uuid" ]; } \
         || { [ -n "$name" ] && [ "${names[$i]}" = "$name" ]; }; then
        mark="●"; break
      fi
    done
    printf '%-40s %-16s %-4s %s\n' "${uuid:--}" "${name:--}" "$mark" "${note:-}"
  done < <(net_list)
  if [ "${#uuids[@]}" -gt 0 ]; then
    printf '（● = 该条已在当前网络生效）\n'
  fi
}

cmd_net_scan() {
  local uuid name type types i=1 hit
  types="$(nmcli -t -f UUID,TYPE connection show --active 2>/dev/null)"
  printf '%-4s %-40s %-16s %-10s %s\n' "序号" "UUID" "连接名" "类型" "白名单"
  while IFS='|' read -r uuid name; do
    [ -z "$uuid" ] && continue
    type="$(printf '%s\n' "$types" | awk -F: -v u="$uuid" '$1==u{print $2; exit}')"
    if net_hit "$uuid" "$name"; then hit="是"; else hit="否"; fi
    printf '%-4s %-40s %-16s %-10s %s\n' "$i" "$uuid" "$name" "${type:-?}" "$hit"
    i=$((i + 1))
  done < <(current_network)
  if [ "$i" -eq 1 ]; then
    echo "（无活动连接）"
  fi
}

cmd_net_add() {
  local arg="${1:-}" note="${2:-}" entry uuid name added=0
  [ -n "$arg" ] || { echo "用法: proxy net add <序号|UUID|连接名> [备注]"; return 2; }
  if [ "$arg" = "--current" ]; then
    while IFS='|' read -r uuid name; do
      [ -z "$uuid" ] && continue
      if net_add "$uuid" "$name" "$note"; then
        printf '已加入：%s（%s）\n' "$name" "$uuid"
        added=$((added + 1))
      fi
    done < <(current_network)
    if [ "$added" -eq 0 ]; then
      echo "当前网络已在白名单中（或无活动连接）"
    fi
  else
    entry="$(net_resolve_arg "$arg")" || return 2
    uuid="${entry%%$'\t'*}"
    name="${entry#*$'\t'}"
    if net_add "$uuid" "$name" "$note"; then
      printf '已加入白名单：%s（%s）\n' "${name:--}" "${uuid:--}"
    else
      echo "已存在或参数无效：$arg" >&2
      return 1
    fi
  fi
  _notify "网络白名单" "已更新（$arg）"
  net_reapply
}

cmd_net_rm() {
  local arg="${1:-}"
  [ -n "$arg" ] || { echo "用法: proxy net rm <UUID|连接名>"; return 2; }
  if net_rm "$arg"; then
    printf '已从白名单移除：%s\n' "$arg"
    _notify "网络白名单" "已移除 $arg"
    net_reapply
  else
    echo "白名单中没有：$arg" >&2
    return 1
  fi
}

cmd_net_status() {
  local want st on net
  want="$(desired_state)"
  st="$(tun_state)"
  net="$(network_name)"
  case "$st" in
    true)  on="on" ;;
    false) on="off" ;;
    *)     on="unknown" ;;
  esac
  printf '当前网络：%s\n白名单期望：TUN=%s\n实际状态：TUN=%s\n' "${net:-无}" "$want" "$on"
  if [ "$on" != "unknown" ] && [ "$want" != "$on" ]; then
    printf '提示：与期望不一致。proxy-watch 仅在“网络变化”时动作，可执行 proxy reload 立即对齐。\n'
  fi
}

cmd_net_help() {
  cat <<EOF
${C_TITLE}proxy net —— 网络白名单（TUN 在哪些网络下自动开启）${C_OFF}

  ${C_BOLD}proxy net${C_OFF} / ${C_BOLD}list${C_OFF}                列出白名单（UUID / 连接名 / 是否命中 / 备注）
  ${C_BOLD}proxy net scan${C_OFF}                 列出当前活动连接（序号 / UUID / 名字 / 类型 / 是否在白名单）
  ${C_BOLD}proxy net add <序号|UUID|连接名> [备注]${C_OFF}   加入白名单（序号取自 scan）
  ${C_BOLD}proxy net add --current [备注]${C_OFF}   把当前所有活动连接加入白名单
  ${C_BOLD}proxy net rm <UUID|连接名>${C_OFF}      从白名单移除
  ${C_BOLD}proxy net status${C_OFF}               当前网络 + 期望/实际 TUN 状态

${C_TITLE}说明${C_OFF}
  ${C_DIM}* 唯一真相：config/networks.conf（本机文件，已 gitignore）；格式 UUID<TAB>名字<TAB>备注。${C_OFF}
  ${C_DIM}* 匹配：UUID 为主、连接名兜底；任一活动连接命中即开 TUN。${C_OFF}
  ${C_DIM}* add/rm 后会按当前网络立即重新施加一次 TUN（等价 proxy reload 的效果）。${C_OFF}
  ${C_DIM}* proxy-watch 只在“网络变化”时自动动作；白名单逻辑见 bin/proxynet.sh。${C_OFF}
EOF
}

cmd_net() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|list)       cmd_net_list ;;
    scan|current)  cmd_net_scan ;;
    add)           cmd_net_add "$@" ;;
    rm)            cmd_net_rm "$@" ;;
    status)        cmd_net_status ;;
    -h|--help|help) cmd_net_help ;;
    *) printf '未知子命令：%s\n\n' "$sub"; cmd_net_help; return 2 ;;
  esac
}

# ---------- proxy lan：局域网共享（手机等设备借用本机代理，见 README §20）----------

cmd_lan_status() {
  local st bind port ip auth want
  st="$(lan_state)"
  bind="$(api_get /configs | python3 -c 'import sys,json;print(json.load(sys.stdin).get("bind-address") or "")' 2>/dev/null)"
  port="${PROXY_MIXED_URL##*:}"
  ip="$(lan_local_ip)"
  auth="$(lan_auth_show)"
  want="$(desired_state)"
  case "$st" in
    true)  printf '局域网共享：已开启（监听 %s:%s）\n' "${bind:-*}" "$port" ;;
    false) printf '局域网共享：已关闭（仅本机 127.0.0.1 可用）\n' ;;
    *)     printf '局域网共享：未知（控制器不可达）\n' ;;
  esac
  [ -n "$ip" ] && printf '本机局域网 IP：%s\n' "$ip"
  if [ -n "$auth" ]; then
    printf '代理认证账号：%s\n' "$auth"
  else
    printf '代理认证账号：未设置（⚠ 任何人可连，建议在 config.yaml 加 authentication）\n'
  fi
  if [ -n "$auth" ] && [ "$auth" != "$(lan_auth_rendered)" ]; then
    printf '⚠ 凭证文件与配置不一致（手改过？）→ 运行 `proxy lan on` 或 `proxy lan auth rotate` 同步\n'
  fi
  printf '按当前网络的期望：%s\n' "$want"
}

cmd_lan_on() {
  controller_up || { echo "控制器不可达" >&2; return 1; }
  lan_auth_sync || true          # 手改过凭证文件时先同步并重载
  set_lan true || return 1
  lan_set_intent on
  local ip port auth
  ip="$(lan_local_ip)"; port="${PROXY_MIXED_URL##*:}"; auth="$(lan_auth_show)"
  printf '局域网共享：已开启（离开白名单网络会自动关）\n'
  if [ -n "$ip" ]; then
    printf '手机端填写 →  主机名: %s   端口: %s\n' "$ip" "$port"
  fi
  [ -n "$auth" ] && printf '              用户名/密码: %s\n' "$auth"
  _notify "局域网共享" "已开启（${ip:-?}）"
}

cmd_lan_off() {
  controller_up || { echo "控制器不可达" >&2; return 1; }
  set_lan false || return 1
  lan_set_intent off
  printf '局域网共享：已关闭\n'
  _notify "局域网共享" "已关闭"
}

cmd_lan_auth_show() {
  printf '账号：%s\n密码：%s\n来源：%s\n' "$(lan_auth_user)" "$(lan_auth_pass)" "$LAN_AUTH_FILE"
}

cmd_lan_auth_rotate() {
  local cred
  cred="$(lan_auth_gen)"
  lan_auth_put "$cred" || return 1
  lan_auth_commit || return 1
  printf '已重新生成随机凭证：%s\n' "$(lan_auth_get)"
  printf '（手机端需重填；当前共享状态：%s）\n' "$(lan_state)"
  _notify "LAN 凭证" "已重新生成随机账号/密码"
}

cmd_lan_auth_set() {
  local u="${1:-}" p="${2:-}"
  [ -n "$u" ] && [ -n "$p" ] || { echo "用法: proxy lan auth set <账号> <密码>"; return 2; }
  lan_auth_put "$u:$p" || return 1
  lan_auth_commit || return 1
  printf '已更新凭证：%s\n' "$(lan_auth_get)"
  _notify "LAN 凭证" "已更新为 $u"
}

cmd_lan_auth_user() {
  local u="${1:-}"
  [ -n "$u" ] || { echo "用法: proxy lan auth user <账号>"; return 2; }
  lan_auth_put "$u:$(lan_auth_pass)" || return 1
  lan_auth_commit || return 1
  printf '已更新账号：%s\n' "$(lan_auth_get)"
  _notify "LAN 凭证" "账号已更新"
}

cmd_lan_auth_pass() {
  local p="${1:-}"
  [ -n "$p" ] || { echo "用法: proxy lan auth pass <密码>"; return 2; }
  lan_auth_put "$(lan_auth_user):$p" || return 1
  lan_auth_commit || return 1
  printf '已更新密码（账号 %s）\n' "$(lan_auth_user)"
  _notify "LAN 凭证" "密码已更新"
}

cmd_lan_auth_help() {
  cat <<EOF
${C_TITLE}proxy lan auth —— 局域网共享的认证凭证${C_OFF}

  ${C_BOLD}proxy lan auth${C_OFF} / ${C_BOLD}show${C_OFF}          查看当前账号 / 密码 / 来源
  ${C_BOLD}proxy lan auth rotate${C_OFF}         重新随机生成（账号 + 密码）
  ${C_BOLD}proxy lan auth set <账号> <密码>${C_OFF}  手动指定
  ${C_BOLD}proxy lan auth user <账号>${C_OFF}     只改账号
  ${C_BOLD}proxy lan auth pass <密码>${C_OFF}     只改密码

${C_TITLE}说明${C_OFF}
  ${C_DIM}* 唯一真相：${LAN_AUTH_FILE}（一行 user:pass，权限 600，已 gitignore）。${C_OFF}
  ${C_DIM}* 缺省随机生成；同时渲染进 config.yaml 的 proxy:lan-auth 标记块并即时生效。${C_OFF}
  ${C_DIM}* 账号：A-Za-z0-9_- ；密码：A-Za-z0-9（8..64，均不含冒号）。${C_OFF}
  ${C_DIM}* 本机（127.0.0.1）始终免认证；仅局域网客户端需填此凭证。${C_OFF}
EOF
}

cmd_lan_auth() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|show) cmd_lan_auth_show ;;
    rotate)  cmd_lan_auth_rotate ;;
    set)     cmd_lan_auth_set "$@" ;;
    user)    cmd_lan_auth_user "$@" ;;
    pass)    cmd_lan_auth_pass "$@" ;;
    -h|--help|help) cmd_lan_auth_help ;;
    *) printf '未知子命令：%s\n\n' "$sub"; cmd_lan_auth_help; return 2 ;;
  esac
}

cmd_lan_help() {
  cat <<EOF
${C_TITLE}proxy lan —— 局域网共享（让手机等设备借用本机 mihomo）${C_OFF}

  ${C_BOLD}proxy lan${C_OFF} / ${C_BOLD}status${C_OFF}   查看共享状态 / 本机 IP / 认证账号
  ${C_BOLD}proxy lan on${C_OFF}               开启（allow-lan=true，监听 0.0.0.0）
  ${C_BOLD}proxy lan off${C_OFF}              关闭（仅本机 127.0.0.1 可用）
  ${C_BOLD}proxy lan auth${C_OFF}              查看 / 重生成 / 修改认证账号密码（auth -h）

${C_TITLE}手机端设置（Wi-Fi → 配置代理 → 手动）${C_OFF}
  ${C_DIM}* 主机名 = 本机局域网 IP；端口 = mixed-port（默认 7890）；${C_OFF}
  ${C_DIM}* 用户名/密码 = proxy lan auth 显示的账号（本机免填）。${C_OFF}

${C_TITLE}说明${C_OFF}
  ${C_DIM}* 与 TUN 一样是“运行时切换”，config.yaml 静态值恒为关闭（127.0.0.1 / false）。${C_OFF}
  ${C_DIM}* 手动开、自动关：运行 proxy lan on 才开启；离开白名单网络时由 proxy-watch 自动关${C_OFF}
  ${C_DIM}  （切回白名单不会自动开，需再次运行 proxy lan on）。${C_OFF}
  ${C_DIM}* 非本机客户端一律需认证，避免在热点/校园网被他人白用。${C_OFF}
  ${C_DIM}* 前提：手机与电脑同一网段（同热点或同路由器），且无客户端隔离。${C_OFF}
EOF
}

cmd_lan() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|status) cmd_lan_status ;;
    on)  cmd_lan_on ;;
    off) cmd_lan_off ;;
    auth) cmd_lan_auth "$@" ;;
    -h|--help|help) cmd_lan_help ;;
    *) printf '未知子命令：%s\n\n' "$sub"; cmd_lan_help; return 2 ;;
  esac
}

cmd_help() {
  cat <<EOF
${C_TITLE}proxy —— mihomo 代理控制台${C_OFF}

用法：proxy <命令> [参数]      主题详情：proxy <sub|time|lang|node|net|lan> -h

${C_TITLE}一、开关${C_OFF}
  ${C_BOLD}proxy on | off | toggle${C_OFF}        开/关/切换 TUN（全局代理）+ 桌面通知

${C_TITLE}二、查看${C_OFF}
  ${C_BOLD}proxy status${C_OFF}                   梯子 / TUN 网卡 / 当前网络 / 节点 / 语言 / 时区
  ${C_BOLD}proxy usage${C_OFF}                    所有机场的流量与到期
  ${C_BOLD}proxy reload${C_OFF}                   重载配置 + 刷新机场 + 按当前网络重新施加 TUN

${C_TITLE}三、机场订阅${C_OFF}
  ${C_BOLD}proxy sub list | show | add | set | rm | fetch${C_OFF}
  ${C_BOLD}proxy sub -h${C_OFF}                   清单 / 渲染 / 校验回滚 / 直连兜底 详情

${C_TITLE}四、时间同步${C_OFF}
  ${C_BOLD}proxy time [--set]${C_OFF}             比对本地↔节点时间；--set 才写系统时钟
  ${C_BOLD}proxy time -h${C_OFF}                  阈值 / 采样 / JSON / 直连 / keep-ntp-off

${C_TITLE}五、语言 / 时区${C_OFF}
  ${C_BOLD}proxy lang [apply|reset|set|show]${C_OFF}   浏览器语言/时区跟随节点
  ${C_BOLD}proxy lang -h${C_OFF}                  详细说明
  ${C_BOLD}proxy-browser [chromium|firefox]${C_OFF}    按当前 region 启动浏览器

${C_TITLE}六、网络白名单${C_OFF}
  ${C_BOLD}proxy net${C_OFF}                     列出白名单（UUID / 连接名 / 是否命中 / 备注）
  ${C_BOLD}proxy net scan${C_OFF}                列出当前活动连接并标出是否在白名单
  ${C_BOLD}proxy net add <序号|UUID|连接名>${C_OFF} 加入白名单（add --current 加入当前网络）
  ${C_BOLD}proxy net rm <UUID|连接名>${C_OFF}     从白名单移除
  ${C_BOLD}proxy net -h${C_OFF}                  数据文件 / 匹配语义 / 生效方式 详情

${C_TITLE}七、节点选择 / 固定${C_OFF}
  ${C_BOLD}proxy node${C_OFF}                    列出可选节点（序号 / 当前 / 延迟）
  ${C_BOLD}proxy node use <序号|名字|子串>${C_OFF} 选定并固定（重启 mihomo 仍生效）
  ${C_BOLD}proxy node auto${C_OFF}               切回「自动选择」（不固定）
  ${C_BOLD}proxy node ping [序号|名字]${C_OFF}    测速（不带参数=全组）
  ${C_BOLD}proxy node -h${C_OFF}                 详细说明

${C_TITLE}八、局域网共享（手机借用本机代理）${C_OFF}
  ${C_BOLD}proxy lan${C_OFF} / ${C_BOLD}status${C_OFF}    共享状态 / 本机局域网 IP / 认证账号
  ${C_BOLD}proxy lan on | off${C_OFF}             开启 / 关闭（运行时切换 allow-lan；手动开、离开白名单自动关）
  ${C_BOLD}proxy lan auth${C_OFF}                 查看 / 重生成 / 修改认证账号密码（默认随机）
  ${C_BOLD}proxy lan -h${C_OFF}                   手机端设置 / 认证 / 网络自动开关 详情

${C_TITLE}九、相关命令${C_OFF}
  ${C_BOLD}proxy-watch -h${C_OFF}                 网络变化自动开关 TUN，并自动关 LAN 共享（systemd 用户服务）

${C_TITLE}十、常见故障${C_OFF}
  ${C_DIM}* 控制器不可达${C_OFF}     → systemctl status ${MIHOMO_SERVICE}
  ${C_DIM}* 连不上外网${C_OFF}       → proxy usage 查到期/流量；proxy status 查 TUN
  ${C_DIM}* 拉不动订阅${C_OFF}       → proxy sub fetch（自动直连兜底）
  ${C_DIM}* 认证门户打不开${C_OFF}   → 该域名在 config.yaml 里设 DIRECT
  ${C_DIM}* 更多排查${C_OFF}         → docs/troubleshooting.md

TUN 由带 CAP_NET_ADMIN 的 ${MIHOMO_SERVICE} 创建；
本命令只发 HTTP 到 ${CTRL_BASE}，无需 sudo。
EOF
}

case "${1:-}" in
  on)      cmd_on ;;
  off)     cmd_off ;;
  status)  cmd_status ;;
  toggle)  cmd_toggle ;;
  usage)   cmd_usage ;;
  time)    shift; cmd_time "$@" ;;
  lang)    shift; cmd_lang "$@" ;;
  node)    shift; cmd_node "$@" ;;
  net)     shift; cmd_net "$@" ;;
  lan)     shift; cmd_lan "$@" ;;
  reload)  cmd_reload ;;
  sub)     shift; cmd_sub "$@" ;;
  -h|--help|help|"") cmd_help ;;
  *) printf '未知命令：%s\n\n' "$1"; cmd_help; exit 2 ;;
esac
